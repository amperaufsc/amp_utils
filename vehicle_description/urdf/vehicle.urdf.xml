<robot name="ampera">

  <link name="base_link">
    <visual>
      <geometry>
        <box size="1.6 0.8 0.3"/>
      </geometry>
    </visual>
  </link>

  <link name="camera_front_link">
    <visual>
      <geometry>
        <box size="0.1 0.05 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="imu_link">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.01"/>
      </geometry>
    </visual>
  </link>

  <link name="gps_link">
    <visual>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </visual>
  </link>

  <link name="lidar_front_link">
    <visual>
      <geometry>
        <box size="0.10 0.10 0.05"/>
      </geometry>
    </visual>
  </link>

  <joint name="camera_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_front_link"/>
    <origin xyz="0.40 0.00 0.25" rpy="0 0 0"/>
  </joint>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="0.00 0.00 0.10" rpy="0 0 0"/>
  </joint>

  <joint name="gps_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gps_link"/>
    <origin xyz="-0.10 0.00 0.30" rpy="0 0 0"/>
  </joint>

  <joint name="lidar_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_front_link"/>
    <origin xyz="0.50 0.00 0.25" rpy="0 0 0"/>
  </joint>

</robot>