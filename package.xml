<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>amp_utils</name>
  <version>0.0.0</version>
  <description>TODO: Package description</description>
  <maintainer email="gustavo.v.alcantara@gmail.com">gustavo</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Dependências de compilação e execução completas -->
  <depend>rclcpp</depend>
  <depend>smach_ros</depend>
  <depend>can_msgs</depend>
  <depend>fs_msgs</depend>

  <!-- Dependências apenas de execução (nós Python, scripts ou plugins) -->
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>stereo_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- Dependências de teste -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
