 SG_ MinCellVoltage : 0|8@1+ (10,0) [0|0] "mV"  DATALOGGER,JETSON

BO_ 321 PAINEL_RTD: 1 PAINEL
 SG_ ReadyToDrive : 0|1@1+ (1,0) [0|0] ""  DATALOGGER,JETSON

BO_ 839 PAINEL_MODE: 1 PAINEL
 SG_ AutonomousMode : 0|3@1+ (1,0) [0|0] ""  DATALOGGER,JETSON

BO_ 1355 PAINEL__PAGE: 1 PAINEL
 SG_ PageID : 0|4@1+ (1,0) [0|0] ""  DATALOGGER,JETSON

BO_ 1185 STEERING_DATA: 5 DATALOGGER
