 SG_ BatteryVoltage : 32|32@1+ (0.1,0) [0|0] "V"  DATALOGGER,JETSON

BO_ 289 VehicleStatus: 8 ECU
 SG_ MaxTemperature : 56|8@1+ (1,0) [0|0] "degC"  DATALOGGER,JETSON
 SG_ BrakeSwitch : 48|1@1+ (1,0) [0|0] ""  DATALOGGER,JETSON
 SG_ BrakePedal : 40|7@1+ (1,0) [0|0] "%"  DATALOGGER,JETSON
 SG_ AcceleratorPedal : 32|8@1+ (1,0) [0|0] "%"  DATALOGGER,JETSON
