 SG_ AccelY : 16|16@1- (0.001,0) [0|0] "m/s²"  JETSON
 SG_ AccelZ : 32|16@1- (0.001,0) [0|0] "m/s²"  JETSON

BO_ 1187 RearWheelEncoders: 8 DATALOGGER
